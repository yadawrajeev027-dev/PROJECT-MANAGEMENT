# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/projectpulse-ai

# Frontend Client URL (for CORS policy)
# Supports single URL, comma-separated URLs, or Vercel domains (e.g. https://your-project.vercel.app)
CLIENT_URL=http://localhost:5173

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# File Upload Configuration
UPLOAD_DIR=uploads/projects
EXTRACTION_DIR=uploads/extracted
MAX_UPLOAD_SIZE=104857600

# AI Provider Configuration (Step 9)
# Supported providers: gemini | openai | anthropic | mock
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_ai_api_key_here
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
